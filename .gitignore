# Whitelist: only the app, plugin and tools are tracked. The engine (audioWhisper/), models (.cache/),
# toolchain and test audio stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/CaptionsApp.ps1
!/version.txt
!/.gitattributes
!/ruff.toml
!/Hushsub Translate.bat
!/app/
!/Plugins/
!/bench/
!/docs/
!/.github/
/Plugins/zz_*
__pycache__/
/bench/clips/
/bench/out/
/bench/test.raw*
/bench/mt/out/
